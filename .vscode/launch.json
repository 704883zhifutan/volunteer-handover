{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "① 运行核对（当前批次）",
      "type": "python",
      "request": "launch",
      "module": "volunteer_handover.main",
      "args": ["--out", "out"],
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "② 桌面推演（W0）",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/examples/demo.py",
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "③ 演示：输入读不到会怎样（C8）",
      "type": "python",
      "request": "launch",
      "module": "volunteer_handover.main",
      "args": ["--simulate-failure", "checkins.csv", "--out", "out/simulated"],
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "④ 调试全部单元测试",
      "type": "python",
      "request": "launch",
      "module": "unittest",
      "args": ["discover", "-s", "tests", "-t", "tests", "-v"],
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "⑤ 调试当前打开的测试文件",
      "type": "python",
      "request": "launch",
      "module": "unittest",
      "args": ["-v", "${fileBasenameNoExtension}"],
      "cwd": "${workspaceFolder}/tests",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "⑥ 调试当前打开的文件",
      "type": "python",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" },
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
